<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.rono</groupId>
    <artifactId>igniscore-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>dist</artifactId>
  <packaging>jar</packaging>

  <name>dist</name>

  <dependencies>
    <dependency>
      <groupId>dev.rono</groupId>
      <artifactId>plugin</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.rono.blocks</groupId>
      <artifactId>nuclear-block</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.rono.blocks</groupId>
      <artifactId>wormhole-block</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.rono.blocks</groupId>
      <artifactId>phantom-block</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.rono.blocks</groupId>
      <artifactId>erupting-block</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.rono.blocks</groupId>
      <artifactId>mimic-block</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.rono.blocks</groupId>
      <artifactId>tunneling-block</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.rono.blocks</groupId>
      <artifactId>entity-block</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>igniscore</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-plugin</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>dev.rono</groupId>
                  <artifactId>plugin</artifactId>
                  <version>${project.version}</version>
                  <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>copy-block-extensions</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/bundled/blocks</outputDirectory>
              <includeGroupIds>dev.rono.blocks</includeGroupIds>
              <stripVersion>true</stripVersion>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <forceCreation>true</forceCreation>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
