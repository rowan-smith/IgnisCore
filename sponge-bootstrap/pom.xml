<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.rono</groupId>
    <artifactId>igniscore-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>sponge-bootstrap</artifactId>
  <packaging>jar</packaging>

  <name>igniscore-sponge-bootstrap</name>
  <description>Deployable Sponge plugin JAR with bundled extensions</description>

  <dependencies>
    <dependency>
      <groupId>dev.rono</groupId>
      <artifactId>api</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.rono</groupId>
      <artifactId>common</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.rono</groupId>
      <artifactId>sponge-v12-0-0</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.inject</groupId>
      <artifactId>guice</artifactId>
    </dependency>
    <dependency>
      <groupId>org.spongepowered</groupId>
      <artifactId>spongeapi</artifactId>
      <version>12.0.0</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>spongepowered-public</id>
      <url>https://repo.spongepowered.org/repository/maven-public/</url>
    </repository>
  </repositories>

  <build>
    <finalName>igniscore-sponge-${project.version}</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <relocations>
                <relocation>
                  <pattern>com.google.inject</pattern>
                  <shadedPattern>dev.rono.igniscore.libs.com.google.inject</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.google.common</pattern>
                  <shadedPattern>dev.rono.igniscore.libs.com.google.common</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>jakarta.inject</pattern>
                  <shadedPattern>dev.rono.igniscore.libs.jakarta.inject</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>bundle-extensions</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.outputDirectory}/bundled/blocks"/>
                <copy todir="${project.build.outputDirectory}/bundled/blocks" flatten="true">
                  <fileset dir="${project.basedir}/../extensions/blocks">
                    <include name="*/target/*.jar"/>
                    <exclude name="*/target/original-*.jar"/>
                  </fileset>
                </copy>
                <mkdir dir="${project.build.outputDirectory}/bundled/items"/>
                <copy todir="${project.build.outputDirectory}/bundled/items" flatten="true">
                  <fileset dir="${project.basedir}/../extensions/items">
                    <include name="*/target/*.jar"/>
                    <exclude name="*/target/original-*.jar"/>
                  </fileset>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <forceCreation>true</forceCreation>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
